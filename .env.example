# ---------------------------------------------------------------------------
# Copiar a `.env` y ajustar. `.env` esta en .gitignore y NUNCA se versiona.
# El arranque valida este contrato con Zod y aborta si algo falta o no encaja.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api

# --- Base de datos --------------------------------------------------------
POSTGRES_USER=salon
POSTGRES_PASSWORD=salon_dev_password
POSTGRES_DB=salon
POSTGRES_PORT=5442
DATABASE_URL="postgresql://salon:salon_dev_password@localhost:5442/salon?schema=public&connection_limit=10"

# --- Seguridad ------------------------------------------------------------
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Deben ser DISTINTOS entre si (ADR-0005) y distintos por entorno.
JWT_ACCESS_SECRET=cambiame_por_un_secreto_de_al_menos_32_caracteres_aleatorios
JWT_REFRESH_SECRET=cambiame_por_otro_secreto_distinto_de_al_menos_32_caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=appsalonbelleza
JWT_AUDIENCE=appsalonbelleza-api

# Parametros Argon2id. Los valores por defecto son el minimo recomendado por OWASP.
# Subir memoryCost antes que timeCost: encarece mas el ataque con GPU.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Lista blanca separada por comas. Nunca `*` cuando se envian credenciales.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Rate limiting (ADR-0007) --------------------------------------------
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=10
THROTTLE_MEDIUM_TTL=60000
THROTTLE_MEDIUM_LIMIT=100
THROTTLE_LONG_TTL=3600000
THROTTLE_LONG_LIMIT=1000
AUTH_THROTTLE_TTL=900000
AUTH_THROTTLE_LIMIT=5

# --- Bloqueo de cuenta ----------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# --- Observabilidad -------------------------------------------------------
LOG_LEVEL=debug
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# --- Reglas de negocio por defecto ---------------------------------------
DEFAULT_CURRENCY=GTQ
DEFAULT_TIMEZONE=America/Guatemala
BODY_LIMIT=1mb

# Almacen de objetos (ADR-0016)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=salon_minio
S3_SECRET_KEY=salon_minio_dev_password
S3_BUCKET=salon-media
PHOTO_URL_TTL_SECONDS=900
PHOTO_MAX_BYTES=10485760
