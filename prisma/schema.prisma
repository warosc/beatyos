// ---------------------------------------------------------------------------
// AppSalonBelleza - Esquema de persistencia
//
// Convenciones transversales (ver docs/adr):
//   - ADR-0003: toda entidad de negocio lleva `tenantId`. Globales: Tenant, Permission.
//   - ADR-0004: toda entidad de negocio lleva soft delete + columnas de autoria.
//   - ADR-0010: el dinero es Decimal(12,2); jamas Float.
//   - Los ids son UUIDv7: ordenados en el tiempo, lo que evita la fragmentacion de
//     indice que produce UUIDv4 al insertar en posiciones aleatorias del B-tree.
//   - Las unicidades de negocio son PARCIALES (`WHERE "deletedAt" IS NULL`). Prisma no
//     sabe expresarlas, asi que aqui se declaran como @@index y la restriccion real se
//     crea en migrations/.../partial_unique_indexes. Por eso las busquedas por clave de
//     negocio usan findFirst y no findUnique.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// PLATAFORMA
// ===========================================================================

/// Un salon. Es la raiz de aislamiento de todo el sistema (ADR-0003).
model Tenant {
  id          String       @id @default(uuid(7))
  name        String
  slug        String       @unique
  legalName   String?
  taxId       String?
  email       String
  phone       String?
  addressLine String?
  city        String?
  country     String       @default("GT")
  timezone    String       @default("America/Guatemala")
  currency    String       @default("GTQ") @db.Char(3)
  locale      String       @default("es-GT")
  status      TenantStatus @default(ACTIVE)
  planCode    String       @default("standard")
  trialEndsAt DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?    @db.Timestamptz(3)
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  users             User[]
  roles             Role[]
  clients           Client[]
  stylists          Stylist[]
  categories        Category[]
  services          Service[]
  appointments      Appointment[]
  products          Product[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  inventoryMoves    InventoryMovement[]
  productBatches    ProductBatch[]
  invoices          Invoice[]
  payments          Payment[]
  cashSessions      CashSession[]
  cashMovements     CashMovement[]
  auditLogs         AuditLog[]
  settings          Setting[]
  documentSequences DocumentSequence[]
  clientPhotos      ClientPhoto[]
  goals             Goal[]

  @@index([status, deletedAt])
  @@map("tenants")
}

/// Ajustes por salon. Clave/valor tipado en lugar de una tabla ancha: los ajustes
/// aparecen y desaparecen con cada iteracion del producto y no merecen una migracion
/// cada vez. Los ajustes con reglas de negocio si tienen columna propia en su modelo.
model Setting {
  id       String      @id @default(uuid(7))
  tenantId String
  key      String
  value    Json
  type     SettingType @default(STRING)
  scope    String      @default("general")
  isSecret Boolean     @default(false)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope, deletedAt])
  @@index([tenantId, key])
  @@map("settings")
}

/// Contador de numeracion de documentos por salon, tipo y ejercicio.
/// Existe para que la numeracion de facturas sea densa y sin huecos, cosa que una
/// secuencia de PostgreSQL no garantiza (una transaccion abortada consume el numero).
/// Se incrementa con bloqueo de fila dentro de la transaccion del documento.
model DocumentSequence {
  id           String       @id @default(uuid(7))
  tenantId     String
  documentType DocumentType
  year         Int
  prefix       String       @default("")
  lastNumber   Int          @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentType, year])
  @@map("document_sequences")
}

// ===========================================================================
// IDENTIDAD, ROLES Y PERMISOS  (ADR-0006)
// ===========================================================================

model User {
  id           String     @id @default(uuid(7))
  tenantId     String?
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  locale       String     @default("es-GT")

  emailVerifiedAt DateTime? @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)
  /// Invalida en bloque todos los access token emitidos (ADR-0005). Se incrementa al
  /// cambiar la contrasena, al desactivar al usuario y al modificar sus roles.
  tokenVersion    Int       @default(0)

  /// Defensa contra fuerza bruta dirigida a una cuenta concreta, complementaria al
  /// rate limiting por IP, que un atacante distribuido puede eludir.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime? @db.Timestamptz(3)
  createdBy           String?
  updatedBy           String?
  deletedBy           String?

  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles               UserRole[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  stylist             Stylist?
  auditLogs           AuditLog[]
  cashSessions        CashSession[]

  @@index([tenantId, email])
  @@index([tenantId, status, deletedAt])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

/// Permiso atomico `recurso.accion`. Global a la plataforma: el catalogo de acciones
/// posibles lo define el software, no el inquilino. Lo que cada salon compone son roles.
model Permission {
  id          String @id @default(uuid(7))
  code        String @unique
  resource    String
  action      String
  description String

  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  roles     RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model Role {
  id          String  @id @default(uuid(7))
  /// NULL = rol de sistema, compartido por todos los salones y no editable.
  tenantId    String?
  code        String
  name        String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@index([tenantId, code])
  @@index([tenantId, deletedAt])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now()) @db.Timestamptz(3)
  grantedBy    String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Refresh token rotativo (ADR-0005). `tokenHash` guarda Argon2id del token, nunca el
/// token: un volcado de esta tabla no permite suplantar a nadie.
/// `familyId` agrupa la cadena de rotaciones; detectar la reutilizacion de un eslabon
/// ya rotado revoca la familia entera.
model RefreshToken {
  id            String    @id @default(uuid(7))
  /// Identificador del JWT (claim `jti`). Es la clave de busqueda al refrescar: el token
  /// se guarda hasheado y no se puede consultar por su valor, asi que el `jti` —que viaja
  /// en claro dentro del JWT firmado— hace de nombre de usuario y el hash, de contrasena.
  /// Se mantiene separado de `id` para no exponer la clave primaria de la tabla dentro
  /// de un token que viaja al cliente.
  jti           String    @unique
  userId        String
  tenantId      String?
  tokenHash     String
  familyId      String
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  revokedReason String?
  replacedById  String?
  userAgent     String?
  ipAddress     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Registro inmutable append-only (ADR-0004). Sin soft delete y sin UPDATE.
model AuditLog {
  id            String      @id @default(uuid(7))
  tenantId      String?
  actorId       String?
  actorEmail    String?
  action        AuditAction
  entityType    String
  entityId      String?
  /// Estado anterior y posterior, con los campos sensibles ya redactados.
  before        Json?
  after         Json?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  metadata      Json?

  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([correlationId])
  @@map("audit_logs")
}

// ===========================================================================
// SALON: CLIENTES Y ESTILISTAS
// ===========================================================================

model Client {
  id          String       @id @default(uuid(7))
  tenantId    String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  birthDate   DateTime?    @db.Date
  gender      Gender?
  notes       String?
  /// Alergias y notas clinicas: critico antes de aplicar quimicos.
  allergies   String?
  addressLine String?
  city        String?
  postalCode  String?
  status      ClientStatus @default(ACTIVE)

  /// Consentimiento explicito para comunicaciones comerciales (RGPD).
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime? @db.Timestamptz(3)
  loyaltyPoints      Int       @default(0)

  /// Metricas desnormalizadas para listados y segmentacion. Recalculables desde
  /// invoices/appointments; se mantienen para no agregar en cada pintado de lista.
  totalVisits Int       @default(0)
  totalSpent  Decimal   @default(0) @db.Decimal(12, 2)
  lastVisitAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  invoices     Invoice[]
  photos       ClientPhoto[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("clients")
}

model Stylist {
  id             String        @id @default(uuid(7))
  tenantId       String
  /// Un estilista puede no tener acceso al sistema; por eso es opcional.
  userId         String?       @unique
  firstName      String
  lastName       String
  email          String?
  phone          String?
  displayName    String?
  bio            String?
  color          String        @default("#8B5CF6")
  status         StylistStatus @default(ACTIVE)
  hiredAt        DateTime?     @db.Date
  /// Porcentaje de comision por defecto, 0-100. El servicio puede sobreescribirlo.
  commissionRate Decimal       @default(0) @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedules    StylistSchedule[]
  timeOff      StylistTimeOff[]
  skills       StylistService[]
  appointments Appointment[]
  invoiceLines InvoiceLine[]
  goals        Goal[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@map("stylists")
}

/// Horario semanal recurrente. `dayOfWeek` 0=domingo .. 6=sabado.
/// Los minutos desde medianoche evitan arrastrar zona horaria en un horario recurrente.
model StylistSchedule {
  id           String @id @default(uuid(7))
  tenantId     String
  stylistId    String
  dayOfWeek    Int    @db.SmallInt
  startMinutes Int    @db.SmallInt
  endMinutes   Int    @db.SmallInt

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@index([tenantId, stylistId, dayOfWeek])
  @@map("stylist_schedules")
}

/// Ausencias puntuales: vacaciones, baja, formacion. Bloquean la agenda.
model StylistTimeOff {
  id        String   @id @default(uuid(7))
  tenantId  String
  stylistId String
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  reason    String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@index([tenantId, stylistId, startsAt, endsAt])
  @@map("stylist_time_off")
}

/// Que servicios sabe hacer cada estilista, y con que ajuste de duracion o comision.
model StylistService {
  stylistId       String
  serviceId       String
  tenantId        String
  /// Sobreescribe la duracion estandar del servicio para este profesional.
  durationMinutes Int?
  commissionRate  Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  stylist   Stylist  @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([stylistId, serviceId])
  @@index([serviceId])
  @@index([tenantId])
  @@map("stylist_services")
}

// ===========================================================================
// METAS E INCENTIVOS
// ===========================================================================

/// Objetivo de facturacion de un profesional en un periodo concreto, con su recompensa.
/// No es una plantilla recurrente: cada mes que la owner quiera repetirlo crea una meta
/// nueva. El progreso no se guarda aqui -se calcula al leer, sumando las lineas de venta
/// del periodo- pero `achievedAt` si se persiste y es de una sola direccion: una vez
/// cumplida, se queda cumplida aunque una anulacion posterior baje la cifra "real".
model Goal {
  id                String     @id @default(uuid(7))
  tenantId          String
  stylistId         String
  metric            GoalMetric
  targetAmount      Decimal    @db.Decimal(12, 2)
  currency          String     @default("GTQ") @db.Char(3)
  periodStart       DateTime   @db.Timestamptz(3)
  periodEnd         DateTime   @db.Timestamptz(3)
  rewardDescription String
  achievedAt        DateTime?  @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@index([tenantId, stylistId, deletedAt])
  @@map("goals")
}

// ===========================================================================
// CATALOGO: CATEGORIAS, SERVICIOS Y PRODUCTOS
// ===========================================================================

/// Categoria unica para servicios y productos, discriminada por `kind`. Dos tablas
/// identicas serian duplicacion; el arbol y su gestion son exactamente los mismos.
model Category {
  id          String       @id @default(uuid(7))
  tenantId    String
  kind        CategoryKind
  name        String
  slug        String
  description String?
  color       String?
  parentId    String?
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  services Service[]
  products Product[]

  @@index([tenantId, kind, deletedAt])
  @@index([tenantId, parentId])
  @@index([tenantId, kind, slug])
  @@map("categories")
}

model Service {
  id               String   @id @default(uuid(7))
  tenantId         String
  categoryId       String?
  code             String
  name             String
  description      String?
  durationMinutes  Int
  /// Margen posterior para limpieza y preparacion; bloquea agenda pero no se factura.
  bufferMinutes    Int      @default(0)
  price            Decimal  @db.Decimal(12, 2)
  currency         String   @default("GTQ") @db.Char(3)
  taxRate          Decimal  @default(12) @db.Decimal(5, 2)
  commissionRate   Decimal? @db.Decimal(5, 2)
  isActive         Boolean  @default(true)
  /// Reservable online por el cliente final, frente a solo agendable por el salon.
  isBookableOnline Boolean  @default(true)
  color            String?
  sortOrder        Int      @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         Category?            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  stylists         StylistService[]
  appointmentItems AppointmentService[]
  invoiceLines     InvoiceLine[]
  consumables      ServiceConsumable[]
  clientPhotos     ClientPhoto[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, categoryId])
  @@index([tenantId, code])
  @@map("services")
}

/// Escandallo: producto que consume un servicio al ejecutarse. Alimenta los movimientos
/// de tipo SERVICE_CONSUMPTION y permite calcular el margen real del servicio.
model ServiceConsumable {
  id        String  @id @default(uuid(7))
  tenantId  String
  serviceId String
  productId String
  quantity  Decimal @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([serviceId, productId])
  @@index([tenantId])
  @@index([productId])
  @@map("service_consumables")
}

model Product {
  id          String  @id @default(uuid(7))
  tenantId    String
  categoryId  String?
  sku         String
  barcode     String?
  name        String
  description String?
  brand       String?

  /// Precio de venta al publico. Puede ser 0 en productos de uso interno.
  price     Decimal @db.Decimal(12, 2)
  /// Coste medio ponderado, recalculado en cada entrada (ADR-0011).
  costPrice Decimal @default(0) @db.Decimal(12, 2)
  currency  String  @default("GTQ") @db.Char(3)
  taxRate   Decimal @default(12) @db.Decimal(5, 2)

  unit            ProductUnit @default(UNIT)
  /// Cache materializada del ledger de movimientos. NO es la fuente de verdad.
  stockOnHand     Decimal     @default(0) @db.Decimal(12, 3)
  reorderPoint    Decimal     @default(0) @db.Decimal(12, 3)
  reorderQuantity Decimal     @default(0) @db.Decimal(12, 3)

  /// Se vende al cliente, se consume en cabina, o ambas.
  isRetail   Boolean @default(true)
  isInternal Boolean @default(false)
  isActive   Boolean @default(true)
  trackStock Boolean @default(true)

  /// Seguimiento por lote y caducidad (ADR-0012).
  ///
  /// Opcional a proposito: un secador no tiene lote y obligar a inventarlo uno por cada
  /// entrada solo consigue que la encargada teclee «1» y el dato deje de significar nada.
  /// Un tinte si lo tiene, y ahi la trazabilidad es una obligacion legal.
  tracksBatches Boolean @default(false)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements      InventoryMovement[]
  poLines        PurchaseOrderLine[]
  invoiceLines   InvoiceLine[]
  consumedBy     ServiceConsumable[]
  suppliers      SupplierProduct[]
  productBatches ProductBatch[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, categoryId])
  @@index([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, isActive, stockOnHand])
  @@map("products")
}

// ===========================================================================
// AGENDA
// ===========================================================================

/// Una cita ocupa un intervalo [startsAt, endsAt) de un estilista.
/// El solapamiento lo impide una restriccion EXCLUDE de PostgreSQL (ver migracion
/// appointment_overlap_constraint): la comprobacion en el dominio da un buen mensaje de
/// error, pero solo la base de datos puede garantizarlo bajo peticiones concurrentes.
model Appointment {
  id            String            @id @default(uuid(7))
  tenantId      String
  clientId      String
  stylistId     String
  startsAt      DateTime          @db.Timestamptz(3)
  endsAt        DateTime          @db.Timestamptz(3)
  status        AppointmentStatus @default(SCHEDULED)
  source        AppointmentSource @default(WALK_IN)
  notes         String?
  internalNotes String?

  confirmedAt        DateTime? @db.Timestamptz(3)
  startedAt          DateTime? @db.Timestamptz(3)
  completedAt        DateTime? @db.Timestamptz(3)
  cancelledAt        DateTime? @db.Timestamptz(3)
  cancelledBy        String?
  cancellationReason String?
  noShowAt           DateTime? @db.Timestamptz(3)
  reminderSentAt     DateTime? @db.Timestamptz(3)
  /// Total previsto al agendar. El importe real de la visita vive en la factura.
  estimatedTotal     Decimal   @default(0) @db.Decimal(12, 2)
  currency           String    @default("GTQ") @db.Char(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  stylist      Stylist              @relation(fields: [stylistId], references: [id], onDelete: Restrict)
  services     AppointmentService[]
  invoice      Invoice?
  clientPhotos ClientPhoto[]

  @@index([tenantId, startsAt])
  @@index([tenantId, stylistId, startsAt])
  @@index([tenantId, clientId, startsAt])
  @@index([tenantId, status, startsAt])
  @@map("appointments")
}

/// Linea de servicio de una cita. Congela precio y duracion en el momento de agendar:
/// cambiar la tarifa del catalogo no debe alterar citas ya cerradas.
model AppointmentService {
  id              String  @id @default(uuid(7))
  tenantId        String
  appointmentId   String
  serviceId       String
  durationMinutes Int
  price           Decimal @db.Decimal(12, 2)
  currency        String  @default("GTQ") @db.Char(3)
