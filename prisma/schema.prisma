/// Tipo de foto dentro del historial de una clienta.
enum ClientPhotoKind {
  /// Antes del servicio. Es la referencia contra la que se compara el resultado.
  BEFORE
  /// Despues del servicio.
  AFTER
  /// La que trae la clienta como ejemplo de lo que quiere.
  REFERENCE
  /// Formula de color anotada, tarjeta de mezcla, prueba de mecha.
  FORMULA
  OTHER
}

/// Origen del consentimiento para guardar la imagen.
enum PhotoConsentSource {
  /// Firmado en papel o en tableta, en el propio salon.
  IN_PERSON
  /// Aceptado en el portal de la clienta o por enlace.
  ONLINE
  /// Consentimiento verbal, anotado por quien atendio.
  VERBAL
}

/// Foto del historial de una clienta (ADR-0016).
///
/// El fichero **no** vive aqui: vive en el almacen de objetos y esta fila guarda la
/// referencia. Un `bytea` de tres megas por foto infla las copias de seguridad, se pasea
/// entero en cualquier consulta que olvide excluir la columna y convierte un `pg_dump` de
/// minutos en uno de horas.
///
/// La imagen de una persona es un dato personal, asi que el consentimiento es una columna
/// obligatoria y no una casilla en la interfaz: sin sitio donde guardarlo, la unica prueba
/// de que se pidio seria la palabra de quien lo pidio.
model ClientPhoto {
  id            String  @id @default(uuid(7))
  tenantId      String
  clientId      String
  /// Cita en la que se tomo. Nulo en una foto suelta o en una de referencia.
  appointmentId String?
  /// Servicio al que corresponde. Permite ver el historial de un tratamiento concreto.
  serviceId     String?

  kind ClientPhotoKind @default(OTHER)

  /// Ruta del objeto en el almacen. Unica: dos filas apuntando al mismo fichero harian que
  /// borrar una dejara a la otra sirviendo un objeto inexistente.
  storageKey   String
  mimeType     String
  sizeBytes    Int
  /// SHA-256 del contenido. Detecta duplicados y prueba que el fichero no ha cambiado.
  checksum     String  @db.Char(64)
  width        Int?
  height       Int?
  /// Nombre con el que se subio. Solo para mostrar; nunca para construir rutas.
  originalName String?

  caption String?
  notes   String?
  takenAt DateTime @default(now()) @db.Timestamptz(3)

  /// Momento en que la clienta autorizo guardar su imagen. Sin esto no se sube nada.
  consentGivenAt  DateTime           @db.Timestamptz(3)
  consentSource   PhotoConsentSource @default(IN_PERSON)
  /// Autoriza ademas usarla en redes o en el portfolio del salon. Es otra decision.
  allowsMarketing Boolean            @default(false)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  /// Momento en que el objeto se borro del almacen.
  ///
  /// El borrado logico oculta la foto y deja el fichero donde estaba, lo que no vale cuando
  /// una clienta ejerce su derecho de supresion. Esta columna separa «ya no se ve» de «ya no
  /// existe», que son dos hechos distintos y hay que poder demostrar el segundo.
  purgedAt DateTime? @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId, takenAt])
  @@index([tenantId, appointmentId])
  @@index([tenantId, deletedAt])
  @@map("client_photos")
}
