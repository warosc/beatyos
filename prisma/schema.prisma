}

// ===========================================================================
// INVENTARIO  (ADR-0011)
// ===========================================================================

/// Ledger append-only. Nunca se actualiza ni se borra: una entrada erronea se corrige
/// con un movimiento compensatorio. Por eso, y a diferencia del resto, no lleva
/// soft delete ni `updatedAt`.
model InventoryMovement {
  id            String       @id @default(uuid(7))
  tenantId      String
  productId     String
  type          MovementType
  /// Con signo: positivo entra, negativo sale. Nunca cero.
  quantityDelta Decimal      @db.Decimal(12, 3)
  /// Stock resultante tras aplicar el movimiento. Redundante pero permite auditar el
  /// ledger sin recalcular la serie completa, y detectar divergencias de la cache.
  balanceAfter  Decimal      @db.Decimal(12, 3)
  unitCost      Decimal?     @db.Decimal(12, 2)
  currency      String       @default("GTQ") @db.Char(3)

  /// Documento que origino el movimiento, para trazar en ambos sentidos.
  sourceType MovementSourceType @default(MANUAL)
  sourceId   String?
  reason     String?
  notes      String?

  purchaseOrderId String?

  /// Lote del que sale o al que entra la mercancia (ADR-0012).
  ///
  /// Nulo en productos sin seguimiento por lote. Es lo que permite responder «que lote se
  /// le aplico a esta clienta», que es una obligacion del Reglamento 1223/2009 y no una
  /// comodidad de gestion.
  batchId String?

  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  createdBy  String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  batch         ProductBatch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([tenantId, batchId])
  @@index([tenantId, productId, occurredAt])
  @@index([tenantId, type, occurredAt])
  @@index([tenantId, sourceType, sourceId])
  @@map("inventory_movements")
}

/// Lote de producto con su caducidad (ADR-0012).
///
/// Existe uno por cada recepcion de mercancia. Guarda el coste **real** de esa entrada, de
/// modo que el margen de un servicio deje de ser una estimacion, y la caducidad, que es lo
/// que ordena el consumo: primero sale lo que antes vence (FEFO), no lo que antes llego.
///
/// Un lote agotado **no se borra**: la trazabilidad lo necesita años despues, cuando haya
/// que responder de que lote salio el producto que provoco una reaccion.
model ProductBatch {
  id        String @id @default(uuid(7))
  tenantId  String
  productId String

  /// Numero impreso en el envase. Es el que figura en una reclamacion.
  batchNumber String
  /// Nulo en productos que no caducan pero si se quieren trazar por lote.
  expiresAt   DateTime? @db.Date

  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  /// Cantidad que entro. No cambia nunca: es el historico de la recepcion.
  initialQuantity   Decimal @db.Decimal(12, 3)
  /// Lo que queda. Baja con cada consumo y nunca puede ser negativo.
  remainingQuantity Decimal @db.Decimal(12, 3)

  /// Coste real de este lote. Con lotes no se promedia: se sabe.
  unitCost Decimal @db.Decimal(12, 2)
  currency String  @default("GTQ") @db.Char(3)

  supplierId      String?
  purchaseOrderId String?
  notes           String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]

  /// Indice de consumo FEFO: por producto, ordenado por caducidad. El filtro parcial deja
  /// fuera los lotes agotados, que son la mayoria en cuanto el salon lleva un tiempo.
  @@index([tenantId, productId, expiresAt])
  @@index([tenantId, expiresAt])
  @@index([tenantId, productId, deletedAt])
  @@map("product_batches")
}

// ===========================================================================
// FACTURACION Y COBROS
// ===========================================================================

model Invoice {
  id            String        @id @default(uuid(7))
  tenantId      String
  clientId      String?
  appointmentId String?       @unique
  number        String
  status        InvoiceStatus @default(DRAFT)

  issuedAt   DateTime? @db.Timestamptz(3)
  dueAt      DateTime? @db.Timestamptz(3)
  paidAt     DateTime? @db.Timestamptz(3)
  voidedAt   DateTime? @db.Timestamptz(3)
  voidReason String?

  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @default(0) @db.Decimal(12, 2)
  paidTotal     Decimal @default(0) @db.Decimal(12, 2)
  /// Derivado de total - paidTotal, materializado para filtrar deudores sin agregar.
  balanceDue    Decimal @default(0) @db.Decimal(12, 2)
  currency      String  @default("GTQ") @db.Char(3)

  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(12, 2)

  notes           String?
  /// Datos fiscales del cliente congelados en el momento de emitir: una factura es un
  /// documento historico y no puede cambiar porque el cliente actualice su direccion.
  billingSnapshot Json?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  lines       InvoiceLine[]
  payments    Payment[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, status, issuedAt])
  @@index([tenantId, clientId])
  @@index([tenantId, number])
  @@index([tenantId, balanceDue])
  @@map("invoices")
}

/// Linea de factura. Referencia a servicio o a producto (exactamente uno de los dos,
/// garantizado por CHECK en la migracion), pero congela nombre y precio: la factura
/// debe poder reimprimirse identica dentro de cinco anos aunque el catalogo cambie.
model InvoiceLine {
  id        String          @id @default(uuid(7))
  tenantId  String
  invoiceId String
  kind      InvoiceLineKind
  serviceId String?
  productId String?
  stylistId String?

  description    String
  quantity       Decimal @db.Decimal(12, 3)
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxRate        Decimal @default(12) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  lineSubtotal   Decimal @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)
  currency       String  @default("GTQ") @db.Char(3)

  /// Comision devengada por el profesional en esta linea, congelada al facturar.
  commissionRate   Decimal? @db.Decimal(5, 2)
  commissionAmount Decimal  @default(0) @db.Decimal(12, 2)

  sortOrder Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  stylist   Stylist? @relation(fields: [stylistId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([tenantId, stylistId])
  @@index([productId])
  @@map("invoice_lines")
}

model Payment {
  id        String        @id @default(uuid(7))
  tenantId  String
  invoiceId String
  sessionId String?
  method    PaymentMethod
  status    PaymentStatus @default(COMPLETED)
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("GTQ") @db.Char(3)

  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  reference  String?
  /// Identificador de la pasarela, para conciliar con el extracto.
  externalId String?
  notes      String?

  refundedAt     DateTime? @db.Timestamptz(3)
  refundedAmount Decimal   @default(0) @db.Decimal(12, 2)
  refundReason   String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  session CashSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, deletedAt])
  @@index([tenantId, receivedAt])
  @@index([invoiceId])
  @@index([sessionId])
  @@index([tenantId, method, receivedAt])
  @@map("payments")
}

// ===========================================================================
// CAJA
// ===========================================================================

/// Sesion de caja (turno). Se abre con un fondo, se cierra con un recuento y la
/// diferencia queda registrada: es el control antifraude basico de un salon.
model CashSession {
  id         String            @id @default(uuid(7))
  tenantId   String
  openedById String
  status     CashSessionStatus @default(OPEN)

  openedAt       DateTime  @default(now()) @db.Timestamptz(3)
  openingFloat   Decimal   @db.Decimal(12, 2)
  closedAt       DateTime? @db.Timestamptz(3)
  closedById     String?
  /// Efectivo contado fisicamente al cierre.
  countedAmount  Decimal?  @db.Decimal(12, 2)
  /// Efectivo que el sistema espera: fondo + entradas - salidas.
  expectedAmount Decimal?  @db.Decimal(12, 2)
  /// countedAmount - expectedAmount. Negativo = falta dinero.
  difference     Decimal?  @db.Decimal(12, 2)
  currency       String    @default("GTQ") @db.Char(3)
  notes          String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy  User           @relation(fields: [openedById], references: [id], onDelete: Restrict)
  movements CashMovement[]
  payments  Payment[]

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@map("cash_sessions")
}

/// Entradas y salidas de efectivo que no son cobro de factura: retiradas a banco,
/// pago de un proveedor en efectivo, gastos menores, correcciones de arqueo.
model CashMovement {
  id        String           @id @default(uuid(7))
  tenantId  String
  sessionId String
  type      CashMovementType
  amount    Decimal          @db.Decimal(12, 2)
  currency  String           @default("GTQ") @db.Char(3)
  concept   String
  reference String?
  notes     String?

  occurredAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)
  createdBy  String?
  updatedBy  String?
  deletedBy  String?

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@index([tenantId, occurredAt])
  @@map("cash_movements")
}

