// ===========================================================================
// PROVEEDORES Y COMPRAS
// ===========================================================================

model Supplier {
  id              String         @id @default(uuid(7))
  tenantId        String
  code            String
  name            String
  legalName       String?
  taxId           String?
  email           String?
  phone           String?
  contactName     String?
  addressLine     String?
  city            String?
  postalCode      String?
  country         String         @default("GT")
  /// Dias de pago acordados; alimenta la prevision de tesoreria.
  paymentTermDays Int            @default(30)
  notes           String?
  status          SupplierStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  products       SupplierProduct[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, code])
  @@index([tenantId, name])
  @@map("suppliers")
}

/// Catalogo del proveedor: su referencia y su precio para un producto nuestro.
/// Un mismo producto puede comprarse a varios proveedores a distinto precio.
model SupplierProduct {
  supplierId       String
  productId        String
  tenantId         String
  supplierSku      String?
  costPrice        Decimal @db.Decimal(12, 2)
  currency         String  @default("GTQ") @db.Char(3)
  leadTimeDays     Int     @default(0)
  minOrderQuantity Decimal @default(1) @db.Decimal(12, 3)
  isPreferred      Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([supplierId, productId])
  @@index([productId])
  @@index([tenantId])
  @@map("supplier_products")
}

model PurchaseOrder {
  id         String              @id @default(uuid(7))
  tenantId   String
  supplierId String
  number     String
  status     PurchaseOrderStatus @default(DRAFT)

  orderedAt          DateTime? @db.Timestamptz(3)
  expectedAt         DateTime? @db.Timestamptz(3)
  receivedAt         DateTime? @db.Timestamptz(3)
  cancelledAt        DateTime? @db.Timestamptz(3)
  cancellationReason String?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)
  currency String  @default("GTQ") @db.Char(3)

  supplierReference String?
  notes             String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdBy String?
  updatedBy String?
  deletedBy String?

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines     PurchaseOrderLine[]
  movements InventoryMovement[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, status, orderedAt])
  @@index([tenantId, supplierId])
  @@index([tenantId, number])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid(7))
  tenantId         String
  purchaseOrderId  String
  productId        String
  quantity         Decimal @db.Decimal(12, 3)
  /// Recepcion parcial: una linea puede recibirse en varias entregas.
  receivedQuantity Decimal @default(0) @db.Decimal(12, 3)
  unitCost         Decimal @db.Decimal(12, 2)
  taxRate          Decimal @default(12) @db.Decimal(5, 2)
  lineTotal        Decimal @db.Decimal(12, 2)
  currency         String  @default("GTQ") @db.Char(3)
  notes            String?

  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
