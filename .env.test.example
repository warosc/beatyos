NODE_ENV=test
PORT=3001
DATABASE_URL="postgresql://salon_test:salon_test@localhost:5443/salon_test?schema=public"
JWT_ACCESS_SECRET=test_access_secret_at_least_32_characters_long_ok
JWT_REFRESH_SECRET=test_refresh_secret_at_least_32_characters_long_ok
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ARGON2_MEMORY_COST=8192
ARGON2_TIME_COST=1
ARGON2_PARALLELISM=1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=error
SWAGGER_ENABLED=false
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Limites amplios: la suite comparte una sola IP y con los valores de produccion
# se estrangularia a si misma. El rate limiting se prueba en su propio fichero
# (rate-limiting.integration.spec.ts), que levanta una app con limites minimos.
THROTTLE_SHORT_LIMIT=100000
THROTTLE_MEDIUM_LIMIT=100000
THROTTLE_LONG_LIMIT=100000
AUTH_THROTTLE_LIMIT=100000
DEFAULT_CURRENCY=GTQ
DEFAULT_TIMEZONE=America/Guatemala

# Almacen de objetos (ADR-0016)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=salon_minio
S3_SECRET_KEY=salon_minio_dev_password
S3_BUCKET=salon-media-test
PHOTO_URL_TTL_SECONDS=900
PHOTO_MAX_BYTES=10485760
